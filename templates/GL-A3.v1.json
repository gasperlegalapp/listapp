      "rows": [
        {
          "type": "explain",
          "items": [
            [
              "Custodian",
              "The company that actually holds the money. Its name is on the statement and it does transfers and retitling. Example: Charles Schwab."
            ],
            [
              "Manager / advisor",
              "The person or firm making investment decisions. Often a local advisor using the custodian's platform. They answer questions but usually can't move money."
            ],
            [
              "Brand / origin",
              "Where the account started or the name the family knows it by. Example: a Wells Fargo Advisors account now held at another custodian."
            ]
